# =============================================================================
# Travner backend environment variables
# Copy to `.env` for local development, or configure these in Railway/deploy UI.
# Never commit real credentials. Placeholders below are safe example values.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED in production
# -----------------------------------------------------------------------------
# Local development can use a standalone MongoDB. Production needs a replica
# set because some flows use @Transactional.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=TravnerDB

# -----------------------------------------------------------------------------
# Common (defaults shown)
# -----------------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=dev
APP_UPLOAD_DIR=${user.home}/travner-uploads

LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN
MONGO_LOG_LEVEL=WARN
WEB_LOG_LEVEL=WARN

# -----------------------------------------------------------------------------
# OPTIONAL — AI chatbot (AIService/AIController are enabled)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT=30000
AI_CACHE_TTL=3600

# -----------------------------------------------------------------------------
# OPTIONAL — JWT auth (defaults shown)
# Without a supplied RSA keypair an ephemeral key is generated at startup,
# which invalidates access tokens on restart. Set both PEM values in production.
# -----------------------------------------------------------------------------
# JWT_PRIVATE_KEY_PEM=<PKCS#8 PEM, newlines as \n>
# JWT_PUBLIC_KEY_PEM=<X.509 PEM, newlines as \n>
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=https://travner.local
JWT_REFRESH_COOKIE_NAME=travner_refresh
JWT_REFRESH_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# OPTIONAL — chat limits
# -----------------------------------------------------------------------------
CHAT_MESSAGE_MAX_LENGTH=4000
CHAT_MESSAGE_MAX_ATTACHMENTS=5
CHAT_RATE_LIMIT_MESSAGES=60
CHAT_TYPING_COOLDOWN=2
CHAT_BROKER_TYPE=simple

# -----------------------------------------------------------------------------
# OPTIONAL — one-time bootstrap administrator
# Leave BOTH empty to create no admin on startup. Provide both to create the
# first admin only when no admin exists in the database. Password must be at
# least 12 chars with upper, lower, digit and symbol. Rotate it after first
# login. Values are never logged.
# -----------------------------------------------------------------------------
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_EMAIL=admin@travner.local

# -----------------------------------------------------------------------------
# OPTIONAL — production MongoDB tuning
# -----------------------------------------------------------------------------
# MONGO_MAX_CONNECTIONS=50
# MONGO_MIN_CONNECTIONS=5
# MONGO_MAX_WAIT_TIME=30000
# MONGO_CONNECT_TIMEOUT=10000
# MONGO_SOCKET_TIMEOUT=30000
# MONGO_SERVER_SELECTION_TIMEOUT=30000

# -----------------------------------------------------------------------------
# NOT ACTIVE in this build (kept for reference only)
# Redis caching: CacheConfig.java.disabled — Redis dependency is not declared.
# Elasticsearch: no dependency or configuration in the current build.
# Payments: gateway integration removed (D4). Orders use cash on delivery only.
# -----------------------------------------------------------------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# ELASTICSEARCH_HOST=localhost
# ELASTICSEARCH_PORT=9200

